#!/usr/bin/env bash
# Pre-commit guardrail: tests/check.sh (stylua, then the headless harness when
# the config or its tests change; stylua alone when only other Lua changes).
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip for one commit:    git commit --no-verify
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only --diff-filter=ACMR)"

if printf '%s\n' "$staged" | rg -q '^(init\.lua|lua/|lsp/|tests/|lazy-lock\.json)'; then
  echo "pre-commit: running tests/check.sh"
  if ! "$REPO/tests/check.sh"; then
    echo "pre-commit: checks failed; fix them or commit with --no-verify" >&2
    exit 1
  fi
elif printf '%s\n' "$staged" | rg -q '\.lua$'; then
  "$REPO/tests/check.sh" --lint-only
fi
